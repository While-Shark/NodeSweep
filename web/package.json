  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  }
}
